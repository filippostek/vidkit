{
  "name": "Nexalead Performance Loop (weekly)",
  "nodes": [
    {
      "id": "cron",
      "name": "⏰ Saturday 09:00 CT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        400
      ],
      "parameters": {
        "rule": {
