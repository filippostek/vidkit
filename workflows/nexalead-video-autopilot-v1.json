          "value": "1oOB_LyYbDtw2REj67agYEHjDVJkW26hMClyao1ap3CY"
        },
        "sheetName": {
          "value": "VideoCalendar"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "status",
              "lookupValue": "scheduled"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_CRED_ID",
          "name": "Google OAuth2"
        }
      }
    },
    {
      "id": "filter_due",
      "name": "🕐 Filter Due",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        440,
        600
      ],
      "parameters": {
        "conditions": {
          "options": {},
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.scheduled_datetime }}",
              "rightValue": "={{ $now.toISO() }}",
              "operator": {
                "type": "dateTime",
                "operation": "beforeOrEqual"
              }
            },
            {
              "leftValue": "={{ $json.video_url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "chatgpt",
      "name": "🧠 ChatGPT Captions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        600
      ],
      "parameters": {
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You are the content engine for Nexalead (nexalead.ai). OFFER: Fractional Chief AI Officer for $10M-$200M revenue companies that need AI leadership without hiring a full-time executive. We bring a backend team, AI workflow design, systems consulting, and \\u2014 critically \\u2014 execution, not just strategy. CONCRETE PROMISES: board-ready AI roadmap in 14 days. Three production AI systems live in 45 days. The client owns everything we build \\u2014 code, systems, documentation. No vendor lock-in, no rented seats. PROOF: currently working with Forbes-list retailers, mid-market manufacturers, distributors and brokers across the US and LATAM. ECONOMICS: we are both a money-maker and a money-saver \\u2014 new revenue from AI systems, plus cost removed from manual operations. AUDIENCE: CEO, COO, CFO or board member at a $10M-$200M company. Non-technical. Under pressure to 'do something about AI'. Has been pitched by consultancies that deliver slide decks and disappear. VOICE: direct, concrete numbers, zero jargon, zero hype, slightly contrarian. Never say 'leverage', 'unlock', 'transform', 'journey', 'landscape', 'game-changer', or 'in today's fast-paced world'. Write like an operator talking to another operator. Respond with ONLY a JSON object.\" },\n    { \"role\": \"user\", \"content\": \"Video topic: {{ $json.video_brief }}\\\\nPlatforms: {{ $json.platforms }}\\\\n\\\\nReturn JSON with these keys:\\\\n- title_youtube: max 90 chars, hook-first, no clickbait lies\\\\n- desc_youtube: 3-5 lines, include https://nexalead.ai, then 3-5 hashtags\\\\n- caption_tiktok: max 2200 chars but keep under 150 words, hook in first line, 3-5 hashtags, NO link\\\\n- caption_reels: similar to tiktok, slightly more polished, 3-5 hashtags, NO link\\\\n- caption_facebook: 2-3 sentences plus https://nexalead.ai\\\\n- caption_telegram: 2-3 sentences with HTML <b> tags allowed, include https://nexalead.ai\\\\n- caption_mastodon: max 480 chars, include https://nexalead.ai\\\\n- caption_truthsocial: max 480 chars, business angle, include https://nexalead.ai\\\\n- caption_bluesky: max 280 chars, include https://nexalead.ai\\\\n- caption_tumblr: 2-4 sentences, include https://nexalead.ai\\\\n- title_pinterest: max 100 chars SEO\\\\n- desc_pinterest: max 500 chars with keywords\\\\n- yt_tags: comma separated, 6-10 tags\" }\n  ]\n}",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CRED_ID",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "merge",
      "name": "🔗 Merge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        600
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let ai = {};\ntry { ai = JSON.parse($input.item.json.choices[0].message.content); }\ncatch(e) { ai = { _ai_error: e.message }; }\nconst row = $('🕐 Filter Due').first().json;\nconst platforms = (row.platforms || '').split(',').map(s => s.trim().toLowerCase());\nreturn { json: { ...row, ...ai, _platforms: platforms } };"
      }
    },
