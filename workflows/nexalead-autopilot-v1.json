        "jsCode": "const raw = $input.item.json;\nlet ai = {};\ntry {\n  const content = raw.choices?.[0]?.message?.content || '{}';\n  ai = JSON.parse(content);\n} catch(e) {\n  ai = { error: 'Failed to parse AI response: ' + e.message };\n}\n\n// Get original row data from earlier node\nconst orig = $('🕐 Filter Due Posts').first().json;\n\nreturn { json: { ...orig, ...ai, _platforms: (orig.platforms || '').split(',').map(s => s.trim().toLowerCase()) } };"
      },
