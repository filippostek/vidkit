      "id": "utm_enforce",
      "name": "🔗 UTM Enforce",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        990,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Enforce UTM params on nexalead.ai links in every copy field\nconst d = { ...$input.item.json };\nconst utmMap = {\n  twitter: 'twitter', facebook: 'facebook',\n  threads: 'threads', bluesky: 'bluesky',\n  truthsocial: 'truthsocial', mastodon: 'mastodon',\n  telegram: 'telegram', tumblr: 'tumblr', reddit: 'reddit',\n  blogger: 'blogger', medium: 'medium', substack: 'substack',\n  devto: 'devto', hashnode: 'hashnode',\n};\nfunction addUtm(text, source, medium) {\n  if (!text) return text;\n  return text.replace(\n    /https?:\\/\\/nexalead\\.ai(\\/[^?\\s\"')]*)?(?!\\S*utm_source)/g,\n    (m, path) => {\n      const p = path || '';\n      const sep = p.includes('?') ? '&' : '?';\n      return 'https://nexalead.ai' + p + sep + 'utm_source=' + source + '&utm_medium=' + medium + '&utm_campaign=autopilot';\n    }\n  );\n}\nconst copyFields = Object.keys(d).filter(k => k.startsWith('copy_') || k === 'link_url');\nfor (const field of copyFields) {\n  if (!d[field]) continue;\n  let src = 'direct', med = 'social';\n  for (const [plat, s] of Object.entries(utmMap)) {\n    if (field.toLowerCase().includes(plat)) {\n      src = s;\n      if (['blogger','medium','substack','devto','hashnode'].includes(plat)) med = 'blog';\n      break;\n    }\n  }\n  d[field] = addUtm(d[field], src, med);\n}\nreturn { json: d };"
      }
    },
